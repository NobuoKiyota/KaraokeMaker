youtube_upload_history.html

# songbook: プログラムだけをGitに入れる。曲の中身・鍵・音源などは songbook/.gitignore で除外

# 公開用パスワード(songbook/publish.py が読む)。Gitに入れない
pass.txt

# Cloudflareに公開するための鍵(songbook/deploy が読む)。Gitに入れない
cf_token.txt
